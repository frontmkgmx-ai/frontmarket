{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Perfil de usuário da plataforma Front MK",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "email": { "type": "string" },
        "role": { "type": "string", "enum": ["merchant", "customer", "admin"] },
        "stores": { "type": "array" },
        "kyc": { "type": "object" },
        "kyc_status": { "type": "string" },
        "verified": { "type": "boolean" },
        "createdAt": { "type": "string" }
      },
      "required": ["email", "role"]
    },
    "KycSession": {
      "title": "KycSession",
      "description": "Sessão de verificação de identidade Didit vinculada ao usuário",
      "type": "object",
      "properties": {
        "sessionId": { "type": "string" },
        "uid": { "type": "string" },
        "provider": { "type": "string", "enum": ["didit"] },
        "status": { "type": "string" },
        "eventVersion": { "type": "number" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" },
        "completedAt": { "type": "string" }
      },
      "required": ["sessionId", "uid", "provider", "status"]
    },
    "KycWebhookEvent": {
      "title": "KycWebhookEvent",
      "description": "Registro idempotente de evento de webhook recebido do provedor KYC",
      "type": "object",
      "properties": {
        "eventId": { "type": "string" },
        "sessionId": { "type": "string" },
        "uid": { "type": "string" },
        "status": { "type": "string" },
        "webhookType": { "type": "string" },
        "authMethod": { "type": "string" },
        "receivedAt": { "type": "string" },
        "processedAt": { "type": "string" }
      },
      "required": ["eventId", "status"]
    },
    "Store": {
      "title": "Store",
      "description": "Loja virtual do lojista",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "slug": { "type": "string" },
        "ownerId": { "type": "string" },
        "settings": { "type": "object" },
        "createdAt": { "type": "string" }
      },
      "required": ["name", "slug", "ownerId"]
    },
    "Product": {
      "title": "Product",
      "description": "Produto da loja",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "slug": { "type": "string" },
        "description": { "type": "string" },
        "price": { "type": "number" },
        "promotionalPrice": { "type": "number" },
        "sku": { "type": "string" },
        "categoryId": { "type": "string" },
        "stock": { "type": "number" },
        "active": { "type": "boolean" },
        "isDigital": { "type": "boolean" },
        "images": { "type": "array" },
        "createdAt": { "type": "string" }
      },
      "required": ["name", "price", "active"]
    },
    "Category": {
      "title": "Category",
      "description": "Categoria de produtos da loja",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "slug": { "type": "string" },
        "description": { "type": "string" },
        "active": { "type": "boolean" },
        "order": { "type": "number" }
      },
      "required": ["name", "slug"]
    },
    "Order": {
      "title": "Order",
      "description": "Pedido de compra realizado",
      "type": "object",
      "properties": {
        "storeId": { "type": "string" },
        "customerId": { "type": "string" },
        "items": { "type": "array" },
        "subtotal": { "type": "number" },
        "shipping": { "type": "number" },
        "discount": { "type": "number" },
        "total": { "type": "number" },
        "status": { "type": "string", "enum": ["pending", "processing", "shipped", "delivered", "cancelled", "refunded"] },
        "customer": { "type": "object" },
        "shippingAddress": { "type": "object" },
        "paymentMethod": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["storeId", "total", "status"]
    },
    "Customer": {
      "title": "Customer",
      "description": "Cliente registrado da loja",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "phone": { "type": "string" },
        "totalOrders": { "type": "number" },
        "totalSpent": { "type": "number" },
        "createdAt": { "type": "string" }
      },
      "required": ["name", "email"]
    },
    "Coupon": {
      "title": "Coupon",
      "description": "Cupom de desconto promocional",
      "type": "object",
      "properties": {
        "code": { "type": "string" },
        "discountType": { "type": "string", "enum": ["percentage", "fixed"] },
        "value": { "type": "number" },
        "minOrderValue": { "type": "number" },
        "usageLimit": { "type": "number" },
        "timesUsed": { "type": "number" },
        "active": { "type": "boolean" }
      },
      "required": ["code", "discountType", "value", "active"]
    },
    "Wallet": {
      "title": "Wallet",
      "description": "Estado consolidado da carteira financeira em centavos",
      "type": "object",
      "properties": {
        "pendingBalanceCents": { "type": "number" },
        "availableBalanceCents": { "type": "number" },
        "reservedBalanceCents": { "type": "number" },
        "totalReceivedCents": { "type": "number" },
        "totalWithdrawnCents": { "type": "number" },
        "currency": { "type": "string" },
        "version": { "type": "number" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["pendingBalanceCents", "availableBalanceCents", "reservedBalanceCents", "totalReceivedCents", "totalWithdrawnCents", "currency", "version"]
    },
    "WalletLedger": {
      "title": "WalletLedger",
      "description": "Registro imutável de evento contábil da carteira",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "storeId": { "type": "string" },
        "type": { "type": "string" },
        "amountCents": { "type": "number" },
        "feeCents": { "type": "number" },
        "netAmountCents": { "type": "number" },
        "currency": { "type": "string" },
        "balanceBucket": { "type": "string" },
        "referenceType": { "type": "string" },
        "referenceId": { "type": "string" },
        "idempotencyKey": { "type": "string" },
        "metadata": { "type": "object" },
        "createdAt": { "type": "string" }
      },
      "required": ["storeId", "type", "amountCents", "currency", "balanceBucket", "referenceType", "referenceId", "idempotencyKey"]
    },
    "Withdrawal": {
      "title": "Withdrawal",
      "description": "Solicitação de saque da loja",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "storeId": { "type": "string" },
        "amountCents": { "type": "number" },
        "feeCents": { "type": "number" },
        "totalDeductedCents": { "type": "number" },
        "status": { "type": "string", "enum": ["pending", "processing", "completed", "failed", "cancelled"] },
        "pixKey": { "type": "string" },
        "pixKeyType": { "type": "string" },
        "gateway": { "type": "string" },
        "idempotencyKey": { "type": "string" },
        "misticTransactionId": { "type": "string" },
        "failureReason": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["storeId", "amountCents", "feeCents", "totalDeductedCents", "status", "pixKey", "pixKeyType", "idempotencyKey"]
    },
    "PaymentRelease": {
      "title": "PaymentRelease",
      "description": "Programação de liberação financeira D+3 (72h) de pedido pago",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "storeId": { "type": "string" },
        "orderId": { "type": "string" },
        "amountCents": { "type": "number" },
        "feeCents": { "type": "number" },
        "netAmountCents": { "type": "number" },
        "currency": { "type": "string", "enum": ["BRL"] },
        "paymentMethod": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "released", "blocked", "cancelled"] },
        "confirmedAt": { "type": "string" },
        "releaseAt": { "type": "string" },
        "releasedAt": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["storeId", "orderId", "amountCents", "netAmountCents", "status", "confirmedAt", "releaseAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "Perfis de usuários do sistema"
    },
    "/users/{userId}/kycSessions/{sessionId}": {
      "schema": "KycSession",
      "description": "Sessões e histórico de verificação de identidade do usuário"
    },
    "/kyc_webhook_events/{eventId}": {
      "schema": "KycWebhookEvent",
      "description": "Registro de auditoria e controle de idempotência dos webhooks KYC"
    },
    "/stores/{storeId}": {
      "schema": "Store",
      "description": "Coleção de lojas cadastradas"
    },
    "/stores/{storeId}/categories/{categoryId}": {
      "schema": "Category",
      "description": "Categorias de produtos da loja"
    },
    "/stores/{storeId}/products/{productId}": {
      "schema": "Product",
      "description": "Produtos do catálogo da loja"
    },
    "/stores/{storeId}/orders/{orderId}": {
      "schema": "Order",
      "description": "Pedidos de venda recebidos"
    },
    "/stores/{storeId}/customers/{customerId}": {
      "schema": "Customer",
      "description": "Base de clientes da loja"
    },
    "/stores/{storeId}/coupons/{couponId}": {
      "schema": "Coupon",
      "description": "Cupons de desconto da loja"
    },
    "/stores/{storeId}/wallet/{walletId}": {
      "schema": "Wallet",
      "description": "Estado consolidado da carteira financeira em centavos"
    },
    "/stores/{storeId}/walletLedger/{ledgerId}": {
      "schema": "WalletLedger",
      "description": "Livro razão imutável de eventos e lançamentos financeiros"
    },
    "/stores/{storeId}/withdrawals/{withdrawalId}": {
      "schema": "Withdrawal",
      "description": "Solicitações de saque da loja"
    },
    "/stores/{storeId}/paymentReleases/{releaseId}": {
      "schema": "PaymentRelease",
      "description": "Programação e histórico de liquidações financeiras D+3 (72h) de pedidos da loja"
    }
  }
}
