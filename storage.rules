rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    match /stores/{storeId}/{allPaths=**} {
      // Leitura pública permitida para ativos públicos da loja (logos, banners, produtos)
      allow read: if true;
      // Escrita estritamente restrita ao proprietário da loja com limite de 15MB e tipo imagem
      allow write: if request.auth != null && (
        firestore.get(/databases/(default)/documents/stores/$(storeId)).data.ownerId == request.auth.uid ||
        request.auth.token.storeId == storeId
      ) && request.resource.size < 15 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    match /users/{userId}/{allPaths=**} {
      // Arquivos privados de usuário (apenas o próprio usuário, máx 15MB)
      allow read, write: if request.auth != null && request.auth.uid == userId
        && request.resource.size < 15 * 1024 * 1024;
    }
  }
}
