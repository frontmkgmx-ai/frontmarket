rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isStoreOwner(storeId) {
      return isAuthenticated() && get(/databases/$(database)/documents/stores/$(storeId)).data.ownerId == request.auth.uid;
    }

    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated() && request.auth.uid == userId;
      allow delete: if false;
    }
    
    match /stores/{storeId} {
      allow read: if true;
      allow create: if isAuthenticated() && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if isAuthenticated() && (
        resource.data.ownerId == request.auth.uid ||
        request.resource.data.ownerId == request.auth.uid
      );
      
      match /members/{memberId} {
        allow read, write: if isStoreOwner(storeId);
      }
      match /categories/{categoryId} {
        allow read: if true;
        allow write: if isStoreOwner(storeId);
      }
      match /products/{productId} {
        allow read: if true;
        allow write: if isStoreOwner(storeId);
      }
      match /orders/{orderId} {
        allow create: if true;
        allow read: if isStoreOwner(storeId) || (
          isAuthenticated() && resource.data.customerId == request.auth.uid
        );
        allow update, delete: if isStoreOwner(storeId);
      }
      match /customers/{customerId} {
        allow read, create, update: if true;
        allow delete: if isStoreOwner(storeId);
      }
      match /coupons/{couponId} {
        allow read: if true;
        allow write: if isStoreOwner(storeId);
      }
      match /settings/{settingId} {
        allow read: if true;
        allow write: if isStoreOwner(storeId);
      }
      match /analytics/{metricId} {
        allow read, write: if isStoreOwner(storeId);
      }
      match /activity/{activityId} {
        allow read, write: if isStoreOwner(storeId);
      }
      
      // Coleções Financeiras: Apenas leitura pelo proprietário. 
      // Escrita estritamente bloqueada no cliente (apenas via Firebase Admin SDK no servidor).
      match /withdrawals/{withdrawalId} {
        allow read: if isStoreOwner(storeId);
        allow write: if false;
      }
      match /wallet/{walletId} {
        allow read: if isStoreOwner(storeId);
        allow write: if false;
      }
      match /walletLedger/{ledgerId} {
        allow read: if isStoreOwner(storeId);
        allow write: if false;
      }
    }
  }
}
