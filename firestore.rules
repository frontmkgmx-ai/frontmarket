rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // --- Helper Functions ---
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    function isStoreOwner(storeId) {
      return isAuthenticated() && (
        resource.data.ownerId == request.auth.uid ||
        request.resource.data.ownerId == request.auth.uid ||
        get(/databases/$(database)/documents/stores/$(storeId)).data.ownerId == request.auth.uid
      );
    }

    function isStoreMember(storeId) {
      return isAuthenticated() && (
        get(/databases/$(database)/documents/stores/$(storeId)).data.ownerId == request.auth.uid ||
        exists(/databases/$(database)/documents/stores/$(storeId)/members/$(request.auth.uid))
      );
    }

    // --- Users Profiles ---
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated() && request.auth.uid == userId;
      allow delete: if false; // Proteção contra exclusão acidental de contas
    }

    // --- Stores and Store Management ---
    match /stores/{storeId} {
      // Vitrine pública: Qualquer pessoa pode ler informações da loja
      allow read: if true;
      
      // Criação de nova loja por usuário autenticado
      allow create: if isAuthenticated() && request.resource.data.ownerId == request.auth.uid;
      
      // Edição apenas pelo dono da loja
      allow update, delete: if isAuthenticated() && (
        resource.data.ownerId == request.auth.uid ||
        request.resource.data.ownerId == request.auth.uid
      );

      // 1. Membros da equipe da loja
      match /members/{memberId} {
        allow read, write: if isStoreMember(storeId);
      }

      // 2. Categorias de produtos
      match /categories/{categoryId} {
        allow read: if true;
        allow write: if isStoreMember(storeId);
      }

      // 3. Catálogo de Produtos
      match /products/{productId} {
        allow read: if true;
        allow write: if isStoreMember(storeId);
      }

      // 4. Pedidos (Checkout e Gestão)
      match /orders/{orderId} {
        // Qualquer visitante ou cliente autenticado pode registrar um pedido no checkout
        allow create: if true;
        
        // Leitura: O lojista (dono) ou o próprio cliente que efetuou o pedido
        allow read: if isStoreMember(storeId) || (
          isAuthenticated() && resource.data.customerId == request.auth.uid
        );
        
        // Atualização de status: Apenas equipe do lojista
        allow update, delete: if isStoreMember(storeId);
      }
      
      // 5. Clientes da Loja
      match /customers/{customerId} {
        // Criação no checkout/cadastro da vitrine
        allow create: if true;
        // Leitura e atualização pelo cliente correspondente ou pelo lojista
        allow read, update: if isStoreMember(storeId) || (
          isAuthenticated() && request.auth.uid == customerId
        );
        allow delete: if isStoreMember(storeId);
      }

      // 6. Cupons e Promoções
      match /coupons/{couponId} {
        allow read: if true;
        allow write: if isStoreMember(storeId);
      }

      // 7. Configurações de Pagamento, Frete e Customização
      match /settings/{settingId} {
        allow read: if true;
        allow write: if isStoreMember(storeId);
      }

      // 8. Métricas e Logs de Atividade
      match /analytics/{metricId} {
        allow read, write: if isStoreMember(storeId);
      }

      match /activity/{activityId} {
        allow read, write: if isStoreMember(storeId);
      }
      
      // Fallback seguro para qualquer outra subcoleção futura
      match /{allSubcollections=**} {
        allow read: if true;
        allow write: if isStoreMember(storeId);
      }
    }
  }
}
